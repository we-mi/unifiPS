<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>Unifi.User</Name>
      <ViewSelectedBy>
        <TypeName>Unifi.User</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><PropertyName>ID</PropertyName></ListItem>
              <ListItem><PropertyName>Name</PropertyName></ListItem>
              <ListItem><PropertyName>Email</PropertyName></ListItem>
              <ListItem><PropertyName>LastSiteName</PropertyName></ListItem>
              <ListItem><PropertyName>IsSuperAdmin</PropertyName></ListItem>
              <ListItem><PropertyName>LastLoginIP</PropertyName></ListItem>
              <ListItem><PropertyName>LastLoginTimestamp</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>

    <View>
      <Name>Unifi.Site</Name>
      <ViewSelectedBy>
        <TypeName>Unifi.Site</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><PropertyName>ID</PropertyName></ListItem>
              <ListItem><PropertyName>InternalName</PropertyName></ListItem>
              <ListItem><PropertyName>Name</PropertyName></ListItem>
              <ListItem><PropertyName>DeviceCount</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
  </ViewDefinitions>
</Configuration>